{
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "ModelName": "gpt-oss:20b",
    "RequestTimeoutSeconds": 600
  },
  "WorkspaceFileReader": {
    "MaxLines": 600,
    "MaxCharacters": 24000,
    "MaxBytes": 262144,
    "AllowedExtensions": [
      ".cs",
      ".csproj",
      ".sln",
      ".slnx",
      ".json",
      ".md",
      ".txt",
      ".xml",
      ".yml",
      ".yaml",
      ".java",
      ".c",
      ".h",
      ".cpp",
      ".cc",
      ".cxx",
      ".hpp",
      ".hh",
      ".hxx"
    ]
  },
  "WorkspaceFileListing": {
    "MaxFiles": 200,
    "ExcludedDirectories": [
      ".git",
      "bin",
      "obj",
      ".vs",
      ".ai-work"
    ]
  },
  "AiArtifactStore": {
    "RootDirectory": ".ai-work",
    "SummariesDirectory": "summaries",
    "PlansDirectory": "plans",
    "PendingPlansDirectory": "pending",
    "InProgressPlansDirectory": "in-progress",
    "CompletedPlansDirectory": "completed",
    "OutputDirectory": "output"
  }
}